# ══════════════════════════════════════════════════
# Maverick Hunter — Environment Variables
# ══════════════════════════════════════════════════

# Firebase Service Account (JSON string)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Set via PowerShell: $env:FIREBASE_SERVICE_ACCOUNT = Get-Content path\to\serviceAccountKey.json -Raw
FIREBASE_SERVICE_ACCOUNT=''

# Target user email to monitor in Firestore
TARGET_USER_EMAIL=pandredbz@gmail.com

# Telegram Bot (reuse from QuestLog)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polling interval in milliseconds (default: 5 minutes = 300000)
POLL_INTERVAL_MS=300000

# CLI execution timeout in milliseconds (default: 15 minutes = 900000)
CLI_TIMEOUT_MS=900000

# Max tasks per polling cycle (safety limit)
MAX_TASKS_PER_CYCLE=10

# Workspace root for AI-managed projects
WORKSPACE_DIR=C:\Users\usuario\Documents\Workspace.AI\Autonomus

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
